# PostgreSQL (local Docker)
DATABASE_URL="postgresql://mundoporix:mundoporix_dev@localhost:5432/mundoporix?schema=public"

# App
NODE_ENV=development
PORT=3050
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001

# JWT — IMPORTANTE: cambiar en producción
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Throttling (solicitudes por minuto)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Duración de reservas (horas)
RESERVATION_EXPIRATION_HOURS=24

# Notificaciones (stubs por defecto)
NOTIFICATIONS_ENABLED=false
